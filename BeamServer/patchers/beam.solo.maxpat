, 			{
				"box" : 				{
					"id" : "obj-2",
					"linecount" : 23,
					"maxclass" : "comment",
					"numinlets" : 1,
					"numoutlets" : 0,
					"patching_rect" : [ 490.0, 24.0, 244.0, 315.0 ],
					"text" : "A simple utility for activating the [beam.output] object it is connected to and deactivating any other [beam.output] instances that have the [beam.solo] abstraction without a name or a different name argument specified connected to them.\n\nUse when you have multiple patchers with Beam objects open and want to quickly activate the current patcher while simultaneously deactivating all the others, e.g. in Beam helpfiles.\n\nWhen a bang is received, 1 is sent out of the banged instance and 0 out of any instances without a name or with a different name argument.\n\nWhen a message with a beam.solo name is received, 1 is sent out of the instance with the matching name argument and 0 out of all the others."
				}

			}
